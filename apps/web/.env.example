# ---- @sc2tools/web env ----
# Locally: cp .env.example .env.local and fill the values.
# On Vercel: set these in Project → Settings → Environment Variables.

# Public — exposed to the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_APP_NAME=SC2 Tools
# Canonical site origin for SEO (sitemap, robots, Open Graph). Defaults to
# https://sc2tools.com when unset.
NEXT_PUBLIC_SITE_URL=https://sc2tools.com

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). The site
# loads GA4 — but ONLY after the visitor opts in via the cookie banner
# (GDPR opt-in / Consent Mode v2). Defaults to the production property
# (G-Y90FRFK3D7) in code, so you only need to set this to override it
# (e.g. a staging property) or set it EMPTY to disable analytics entirely.
# Find it in GA: Admin → Data Streams → your web stream → Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Y90FRFK3D7

# Server-only
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/app
CLERK_AFTER_SIGN_UP_URL=/app

# Local preview of the admin-gated SC2 3D alert media. Set to 1 in .env.local,
# drop the render WebM/WebP into apps/web/public/alerts/sc2-3d (untracked --
# that directory ignores media), and the 3D presets render without a deployed
# API or R2 credentials. Development only; ignored in a production build.
NEXT_PUBLIC_ALERT_MEDIA_LOCAL_FALLBACK=

# Base URL for the baked SC2 unit/building sprite sheets. Empty or unset
# serves them from apps/web/public/sprites (local dev only -- that folder
# is gitignored). In production point this at the R2 bucket / Worker,
# e.g. https://cdn.sc2tools.com/sprites/v1
NEXT_PUBLIC_SPRITE_BASE=/sprites

# Base URL for the replay background score. Empty or unset serves from
# apps/web/public/audio/replay (local dev only -- that folder is
# gitignored). In production point this at the sc2tools-audio R2 bucket
# (public access must be enabled, and it must send CORS headers -- the
# Web Audio battle-swell needs crossOrigin to succeed).
NEXT_PUBLIC_AUDIO_BASE=/audio/replay
