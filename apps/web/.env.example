# ---- @sc2tools/web env ----
# Locally: cp .env.example .env.local and fill the values.
# On Vercel: set these in Project → Settings → Environment Variables.

# Public — exposed to the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_APP_NAME=SC2 Tools
# Canonical site origin for SEO (sitemap, robots, Open Graph). Defaults to
# https://sc2tools.com when unset.
NEXT_PUBLIC_SITE_URL=https://sc2tools.com

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). When set,
# the site loads GA4 — but ONLY after the visitor opts in via the cookie
# banner (GDPR opt-in / Consent Mode v2). Leave blank to disable analytics
# entirely (the banner then hides itself). Find it in GA: Admin → Data
# Streams → your web stream → Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/app
CLERK_AFTER_SIGN_UP_URL=/app
