# ---- SC2 Tools cloud API env ----
# Copy this file to .env (never commit .env). Render reads these from
# the dashboard; locally, dotenv loads .env.

# HTTP
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# MongoDB Atlas. Use a separate database from community-builds.
# Atlas connection string:  mongodb+srv://<user>:<pass>@<host>/?...
MONGODB_URI=
MONGODB_DB=sc2tools_saas

# Heavy per-game detail storage. Keep the safe local/default value until the
# R2 credentials below are configured; production can then set this to r2.
GAME_DETAILS_STORE=mongo
# Cloudflare R2 S3 endpoint, for example:
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=game-details
# Original .SC2Replay objects share the private bucket but use a separate
# prefix. Add a one-day lifecycle expiry for <prefix>-pending/ in R2.
# R2 credentials enable short-lived direct upload/download URLs.
REPLAY_FILES_STORE=disabled
R2_REPLAY_PREFIX=raw-replays/v1

# Optional public infrastructure-cost snapshot. Create a separate Cloudflare
# API token scoped to Account > Account Analytics > Read. The R2 S3 access key
# above cannot call GraphQL Analytics. Account id + token must be set together;
# the analytics query always uses the existing R2_BUCKET value.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
# UTC billing-cycle start day, from 1 through 28 (defaults to 1).
CLOUDFLARE_BILLING_CYCLE_DAY=1

# Clerk — server SDK keys, get from https://dashboard.clerk.com → API keys
CLERK_SECRET_KEY=
# Optional: lock JWTs to a known issuer + audience (recommended in prod)
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=

# 32 random bytes hex-encoded — used to HMAC opponent battle-tags before
# write so cloud DB never stores plaintext PII. Generate with:
#   openssl rand -hex 32
SERVER_PEPPER_HEX=

# CORS — comma-separated list of origins. Include your Vercel URL +
# localhost for dev. Empty = allow all (dev only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://sc2tools.app

# How many requests/min/user we allow. 600 gives agent initial imports
# headroom; the agent's Retry-After backoff handles anything beyond it.
RATE_LIMIT_PER_MINUTE=600

# ---- Forward-only opponent MMR enrichment ----
# SC2Pulse supplies current per-race 1v1 MMR, so the job only considers
# recent ladder games and treats that rating as an approximation of MMR at
# game time. The createdAt window defaults to 14 days and is hard-capped at
# 30 days; existing opponent.mmr values are never overwritten.
# Set the disable knob to 1 for an operational rollback.
SC2TOOLS_OPP_MMR_ENRICH_DISABLED=
SC2TOOLS_OPP_MMR_ENRICH_INTERVAL_SEC=900
SC2TOOLS_OPP_MMR_ENRICH_WINDOW_DAYS=14
SC2TOOLS_OPP_MMR_ENRICH_GAMES_PER_TICK=25

# ---- Agent release feed (Stage D) ----
# Random secret used to authenticate POST /v1/agent/releases.
# Anyone holding this token can publish a new agent installer URL,
# so treat it like SERVER_PEPPER_HEX. Generate with:
#   openssl rand -hex 32
AGENT_RELEASE_ADMIN_TOKEN=

# ---- Admin access ----
# Who can reach the /admin console + /v1/admin/* API. Two allowlists,
# both optional; a user is admin if they match EITHER. There is no
# "first user becomes admin" magic — admins are always explicit.
#
# SC2TOOLS_ADMIN_EMAILS — CSV of email addresses (case-insensitive). The
# simplest path: any signed-in user whose verified Clerk email matches is
# granted the admin role on their next page load, and that grant persists.
SC2TOOLS_ADMIN_EMAILS=
# SC2TOOLS_ADMIN_USER_IDS — CSV of Clerk user IDs (the `user_xxx` strings
# from the Clerk dashboard). Use when you'd rather pin by ID than email.
SC2TOOLS_ADMIN_USER_IDS=
# Once at least one admin exists, they can promote others from the admin
# user-detail page (POST /v1/admin/users/:id/grant-admin) — no env change.

# ---- Python toolchain (Stage C bucket 2) ----
# The Dockerfile pre-installs the engine's Python deps into a venv at
# /opt/sc2-py and copies apps/replay-engine/ to /opt/sc2-analyzer.
# These two env vars tell the API where to find them. Override only if
# you've staged the analyzer somewhere non-standard or are running
# locally without the container.
SC2_PY_PYTHON=
SC2_PY_ANALYZER_DIR=

# Optional: override the directory the /v1/map-image route serves from.
# Defaults to ${SC2_PY_ANALYZER_DIR}/data/map_assets.
SC2_MAP_IMAGE_DIR=

# ---- Google Analytics 4 Data API (admin Analytics tab) ----
# Powers /admin/analytics, which reads REAL GA4 metrics server-side.
# Leave GA4_PROPERTY_ID blank to disable the tab (it then renders a
# "not configured" hint instead of erroring).
#
# GA4_PROPERTY_ID is the NUMERIC property id (not the G-XXXX measurement
# id). Find it in GA: Admin → Property settings → Property ID.
GA4_PROPERTY_ID=
#
# Auth: a Google Cloud service account with "Viewer" access to the GA4
# property (add it under Admin → Property Access Management). Provide its
# JSON key ONE of two ways:
#   1. Base64-encoded inline (best for Vercel/Render/serverless):
#        base64 -w0 service-account.json   # Linux
#        base64 service-account.json       # macOS
GA_SERVICE_ACCOUNT_KEY_B64=
#   2. OR a path to the key file on disk (for a VM/container with a
#      mounted secret) — the google-auth library reads it automatically:
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/ga-service-account.json

# ---- Observability ----
# Sentry error reporting. @sentry/node is a real dependency; set the
# DSN to turn capture on. Boot logs a `sentry_state` line so you can
# confirm it's live from Render logs.
SENTRY_DSN=

# Mongo commands slower than this many milliseconds are logged as
# `slow_query` (with command name + collection). Default 100.
SLOW_QUERY_MS=

# Bearer token guarding GET /v1/metrics (Prometheus exposition:
# Node process defaults + live-overlay broker counters). Leave unset
# to disable the endpoint entirely. Generate with: openssl rand -hex 32
METRICS_TOKEN=
