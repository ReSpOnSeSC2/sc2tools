# ---- SC2 Tools cloud API env ----
# Copy this file to .env (never commit .env). Render reads these from
# the dashboard; locally, dotenv loads .env.

# HTTP
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# MongoDB Atlas. Use a separate database from community-builds.
# Atlas connection string:  mongodb+srv://<user>:<pass>@<host>/?...
MONGODB_URI=
MONGODB_DB=sc2tools_saas

# Heavy per-game detail storage. Keep the safe local/default value until the
# R2 credentials below are configured; production can then set this to r2.
GAME_DETAILS_STORE=mongo
# Cloudflare R2 S3 endpoint, for example:
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=game-details
# Original .SC2Replay objects share the private bucket but use a separate
# prefix. Add a one-day lifecycle expiry for <prefix>-pending/ in R2.
# R2 credentials enable short-lived direct upload/download URLs.
REPLAY_FILES_STORE=disabled
R2_REPLAY_PREFIX=raw-replays/v1
# Browser replay backups PUT straight to the private bucket, which needs a
# PUT-only CORS rule for the CORS_ALLOWED_ORIGINS sites. With the replay
# store on, the API adds that rule at boot when its R2 key may change bucket
# settings (other rules are kept), then verifies it with a browser-style
# preflight; Admin Health shows the result. 0/false skips the automatic write
# but still verifies. See docs/instant-analysis.md, "Browser replay backup".
R2_BROWSER_CORS_AUTO=1

# Optional public infrastructure-cost snapshot. Create a separate Cloudflare
# API token scoped to Account > Account Analytics > Read. The R2 S3 access key
# above cannot call GraphQL Analytics. Account id + token must be set together;
# the analytics query always uses the existing R2_BUCKET value.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
# UTC billing-cycle start day, from 1 through 28 (defaults to 1).
CLOUDFLARE_BILLING_CYCLE_DAY=1

# Optional live MongoDB Atlas capacity, disk metrics, and pending-invoice
# diagnostics. Create one read-only Atlas service account with Project Read
# Only + Organization Billing Viewer. All five identity settings are required
# together. The expiry timestamp is admin-health metadata only.
ATLAS_SERVICE_ACCOUNT_ID=
ATLAS_SERVICE_ACCOUNT_SECRET=
ATLAS_ORG_ID=
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=
ATLAS_SERVICE_ACCOUNT_SECRET_EXPIRES_AT=

# Optional Render CPU/memory capacity monitoring for authenticated admins.
# Render injects RENDER_SERVICE_ID automatically in a running service. Create
# an API key in Render Account Settings and set only RENDER_API_KEY yourself.
# Important: Render API keys are broadly account-scoped (there is no
# metrics-only key), so keep it server-side and rotate it if exposed. The API
# performs only GET requests and never returns the key or service id.
RENDER_API_KEY=
# Automatic in Render; set locally only when testing the provider adapter.
RENDER_SERVICE_ID=
# Optional operator-maintained planning value. Render does not expose invoice
# totals through this metrics API; update this after changing instance tier.
RENDER_MONTHLY_COST_USD=

# Clerk — server SDK keys, get from https://dashboard.clerk.com → API keys
CLERK_SECRET_KEY=
# Optional: lock JWTs to a known issuer + audience (recommended in prod)
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=

# ---- Official streaming-platform notifications (optional) ----
# OAuth tokens are encrypted with a dedicated 32-byte AES key and never stored
# in generic preferences or returned to Browser Sources. Generate once with:
#   openssl rand -hex 32
# Required whenever ANY provider below is enabled.
PLATFORM_TOKEN_ENCRYPTION_KEY=
PLATFORM_INTEGRATIONS_RETURN_URL=https://sc2tools.com/settings#overlay
# Provider subscription repair runs on this cadence. Twitch user tokens are
# still validated at process startup and at least hourly if this is set higher.
PLATFORM_SUBSCRIPTION_HEALTH_INTERVAL_MS=300000

# Twitch developer application. Register the callback exactly as shown.
# EventSub secret must be 10-100 printable ASCII characters; generate a long
# random value. User OAuth requests least-privilege scopes for follows,
# channel-point redemptions, subscriptions/gifts, and Bits:
# moderator:read:followers channel:read:redemptions
# channel:read:subscriptions bits:read
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_REDIRECT_URI=https://api.sc2tools.com/v1/integrations/twitch/callback
TWITCH_EVENTSUB_CALLBACK_URL=https://api.sc2tools.com/v1/webhooks/twitch/eventsub

# Kick developer application (OAuth 2.1 + PKCE). Register both the callback
# and signed webhook URL in Kick's developer console. OAuth scopes are
# user:read channel:read events:subscribe; official event subscriptions cover
# follows, channel rewards, new/renewed/gift subscriptions, and KICKs gifts.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://api.sc2tools.com/v1/integrations/kick/callback
# Configure this webhook URL in the Kick developer application:
# https://api.sc2tools.com/v1/webhooks/kick/events

# Google OAuth web client with YouTube Data API v3 enabled. This polls the
# official public recent-subscribers list; private subscriptions are hidden by
# YouTube and cannot be alerted. Default interval is five minutes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.sc2tools.com/v1/integrations/youtube/callback
YOUTUBE_SUBSCRIBER_POLL_INTERVAL_MS=300000

# 32 random bytes hex-encoded — used to HMAC opponent battle-tags before
# write so cloud DB never stores plaintext PII. Generate with:
#   openssl rand -hex 32
SERVER_PEPPER_HEX=

# CORS — comma-separated list of origins. Include your Vercel URL +
# localhost for dev. Empty = allow all (dev only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://sc2tools.app

# How many requests/min/user we allow. 600 gives agent initial imports
# headroom; the agent's Retry-After backoff handles anything beyond it.
RATE_LIMIT_PER_MINUTE=600

# Bound memory-heavy POST /v1/games work per API process. Busy batches receive
# a retryable 503 before JSON parsing, and the agent's durable queue retries
# them without skipping files. Raise only after measuring production RSS.
REPLAY_INGEST_MAX_ACTIVE=1

# ---- Browser ingest daily cap ----
# Signed-in browsers can parse replays locally and upload them through
# POST /v1/games. Games accepted from Clerk sessions are counted per user per
# UTC day; a batch that would exceed the cap gets a non-retryable 429
# browser_ingest_daily_cap (Retry-After = seconds until UTC midnight).
# Desktop-agent (device token) uploads are never counted. Must be >= 1.
BROWSER_INGEST_DAILY_CAP=5000

# ---- Forward-only opponent MMR enrichment ----
# SC2Pulse supplies current per-race 1v1 MMR, so the job only considers
# recent ladder games and treats that rating as an approximation of MMR at
# game time. The createdAt window defaults to 14 days and is hard-capped at
# 30 days; existing opponent.mmr values are never overwritten.
# Set the disable knob to 1 for an operational rollback.
SC2TOOLS_OPP_MMR_ENRICH_DISABLED=
SC2TOOLS_OPP_MMR_ENRICH_INTERVAL_SEC=900
SC2TOOLS_OPP_MMR_ENRICH_WINDOW_DAYS=14
SC2TOOLS_OPP_MMR_ENRICH_GAMES_PER_TICK=25

# ---- SC2 Tools Guides: guide sample capture ----
# Every eligible ladder 1v1 upload is distilled into one pseudonymous
# guide_samples row (milestone times + army snapshots) in the background of
# POST /v1/games. Set to 1 to stop capturing and writing samples (reads and
# GDPR deletes keep working).
SC2TOOLS_GUIDE_SAMPLES_DISABLED=
# The admin-triggered backfill (POST /v1/admin/guides/backfill) distils older
# games from game_details at <= 2 games/s. It never starts on its own; set to
# 1 to refuse start requests.
SC2TOOLS_GUIDE_BACKFILL_DISABLED=

# ---- SC2 Tools Guides: public guides + nightly guide_stats ----
# Master switch for the public /v1/guides routes and the nightly guide_stats
# rebuild. "on", "true", "1", "yes" or "all" = on (the same spellings as the
# web's NEXT_PUBLIC_GUIDES_ENABLED); anything else, "admins" included, is off.
GUIDES_ENABLED=
# After each guide_stats run the API POSTs a signed ping here so the web app
# purges its cached guide pages. Point it at the web origin's
# /api/revalidate-guides and use the same secret as the web app's
# GUIDES_REVALIDATE_SECRET. Both unset = pages refresh on their 6 h window.
#   GUIDES_REVALIDATE_URL=https://sc2tools.com/api/revalidate-guides
GUIDES_REVALIDATE_URL=
GUIDES_REVALIDATE_SECRET=
# guide_stats job: 1 = kill switch (no scheduled or admin-forced runs).
SC2TOOLS_GUIDE_STATS_DISABLED=
# Target spacing between runs in seconds (default 86400, floor 3600).
SC2TOOLS_GUIDE_STATS_INTERVAL_SEC=
# Delay of the first check after boot in seconds (default 900, so the boot
# ladder-meta rebuild finishes first).
SC2TOOLS_GUIDE_STATS_START_DELAY_SEC=

# ---- SC2 Tools Guides: build-order videos ----
# The site owner's YouTube channel. With GUIDES_ENABLED on and a channel id
# set, the API seeds the committed channel snapshot into guide_videos on
# boot and re-reads the channel's public RSS feed every 6 hours; guide pages
# then show the owner's build-order videos. The URL is the public
# "Subscribe on YouTube" link (and lets admins add older videos by id).
#   GUIDES_YOUTUBE_CHANNEL_ID=UCZS3YP1mvpqyuU5vPvHVG7g
#   GUIDES_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@ReSpOnSeSC2
GUIDES_YOUTUBE_CHANNEL_ID=
GUIDES_YOUTUBE_CHANNEL_URL=
# Set to 1 to stop the RSS sync (stored videos keep being served).
SC2TOOLS_GUIDE_VIDEOS_DISABLED=
# Sync interval override in seconds (default 21600 = 6 h, floor 900).
SC2TOOLS_GUIDE_VIDEOS_INTERVAL_SEC=

# ---- Agent release feed (Stage D) ----
# Random secret used to authenticate POST /v1/agent/releases.
# Anyone holding this token can publish a new agent installer URL,
# so treat it like SERVER_PEPPER_HEX. Generate with:
#   openssl rand -hex 32
AGENT_RELEASE_ADMIN_TOKEN=

# ---- Admin access ----
# Who can reach the /admin console + /v1/admin/* API. Two allowlists,
# both optional; a user is admin if they match EITHER. There is no
# "first user becomes admin" magic — admins are always explicit.
#
# SC2TOOLS_ADMIN_EMAILS — CSV of email addresses (case-insensitive). The
# simplest path: any signed-in user whose verified Clerk email matches is
# granted the admin role on their next page load, and that grant persists.
SC2TOOLS_ADMIN_EMAILS=
# SC2TOOLS_ADMIN_USER_IDS — CSV of Clerk user IDs (the `user_xxx` strings
# from the Clerk dashboard). Use when you'd rather pin by ID than email.
SC2TOOLS_ADMIN_USER_IDS=
# Once at least one admin exists, they can promote others from the admin
# user-detail page (POST /v1/admin/users/:id/grant-admin) — no env change.

# ---- Python toolchain (Stage C bucket 2) ----
# The Dockerfile pre-installs the engine's Python deps into a venv at
# /opt/sc2-py and copies apps/replay-engine/ to /opt/sc2-analyzer.
# These two env vars tell the API where to find them. Override only if
# you've staged the analyzer somewhere non-standard or are running
# locally without the container.
SC2_PY_PYTHON=
SC2_PY_ANALYZER_DIR=

# Optional: override the directory the /v1/map-image route serves from.
# Defaults to ${SC2_PY_ANALYZER_DIR}/data/map_assets.
SC2_MAP_IMAGE_DIR=

# ---- Google Analytics 4 Data API (admin Analytics tab) ----
# Powers /admin/analytics, which reads REAL GA4 metrics server-side.
# Leave GA4_PROPERTY_ID blank to disable the tab (it then renders a
# "not configured" hint instead of erroring).
#
# GA4_PROPERTY_ID is the NUMERIC property id (not the G-XXXX measurement
# id). Find it in GA: Admin → Property settings → Property ID.
GA4_PROPERTY_ID=
#
# Auth: a Google Cloud service account with "Viewer" access to the GA4
# property (add it under Admin → Property Access Management). Provide its
# JSON key ONE of two ways:
#   1. Base64-encoded inline (best for Vercel/Render/serverless):
#        base64 -w0 service-account.json   # Linux
#        base64 service-account.json       # macOS
GA_SERVICE_ACCOUNT_KEY_B64=
#   2. OR a path to the key file on disk (for a VM/container with a
#      mounted secret) — the google-auth library reads it automatically:
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/ga-service-account.json

# ---- Observability ----
# Sentry error reporting. @sentry/node is a real dependency; set the
# DSN to turn capture on. Boot logs a `sentry_state` line so you can
# confirm it's live from Render logs.
SENTRY_DSN=

# Mongo commands slower than this many milliseconds are logged as
# `slow_query` (with command name + collection). Default 100.
SLOW_QUERY_MS=

# Bearer token guarding GET /v1/metrics (Prometheus exposition:
# Node process defaults + live-overlay broker counters). Leave unset
# to disable the endpoint entirely. Generate with: openssl rand -hex 32
METRICS_TOKEN=

# Admin-gated SC2 3D alert media. Private bucket; presigned per request for
# admin sessions only. Never given public access or a custom domain -- see
# docs/cloud/ALERT_MEDIA_R2.md.
R2_ALERT_MEDIA_BUCKET=sc2tools-alert-media
R2_ALERT_MEDIA_PREFIX=alerts/sc2-3d
R2_ALERT_MEDIA_EXPIRES_SEC=300
# R2 tokens are bucket-scoped, so the replay-store token above cannot read the
# alert bucket. Set a dedicated Object Read only token scoped to it: the API
# only signs GETs and never writes. Both halves are required; leaving them
# unset falls back to the shared R2 credentials.
R2_ALERT_MEDIA_ACCESS_KEY_ID=
R2_ALERT_MEDIA_SECRET_ACCESS_KEY=

# ---- Replay Review Exchange (docs/reviews.md) ----
# Rollout: off (default) | admins | on. "admins" exposes every review route
# only to platform admins. Set NEXT_PUBLIC_REVIEWS_ENABLED to the same value
# on the web deployment.
REVIEWS_ENABLED=
# Weekly "open requests in your matchups" digest. Checks hourly, sends once
# per ISO week after Monday 15:00 UTC; only runs when REVIEWS_ENABLED=on.
SC2TOOLS_REVIEW_DIGEST_DISABLED=
SC2TOOLS_REVIEW_DIGEST_INTERVAL_SEC=3600
