{
 "_about": "Custom-rule parity cases shared by the desktop evaluator (apps/replay-engine/tests/test_custom_rule_parity.py feeds `events` to check_custom_rules) and the cloud evaluator (apps/api/__tests__/customRuleParity.test.js feeds `build_log` and `proxies` through parseBuildLogLines, eventsToStartTime and evaluateRules). Both must return `expected`. `build_log` and `proxies` are what the agent uploads for `events`; the engine suite and apps/agent/tests re-derive them, so they cannot drift. `proxy` pins the shared proxy geometry.",
 "proxy": {
  "classification_version": 2,
  "default_distance": 50.0,
  "expansion_distance": 80.0,
  "expansion_buildings": [
   "Assimilator",
   "CommandCenter",
   "Extractor",
   "Hatchery",
   "Hive",
   "Lair",
   "Nexus",
   "OrbitalCommand",
   "PlanetaryFortress",
   "Refinery",
   "SpineCrawler",
   "SporeCrawler"
  ]
 },
